{
  "ReverseProxy": {
    "Routes": {
      "wallet": {
        "ClusterId": "wallet",
        "Match": { "Path": "/api/players/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "games": {
        "ClusterId": "games",
        "Match": { "Path": "/api/bets/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "wallet": {
        "Destinations": { "d1": { "Address": "https+http://Wallet-Api" } }
      },
      "games": {
        "Destinations": { "d1": { "Address": "https+http://Games-Api" } }
      }
    }
  }
}